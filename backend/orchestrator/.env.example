# Ключи НЕ коммитить. Копировать в backend/.env рядом.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# В РФ api.telegram.org блокируют провайдеры -> бот не достучится без VPN.
# Чтобы обойтись без VPN, разверните API-прокси (Cloudflare Worker) и укажите его base
# СО СУФФИКСОМ /bot (python-telegram-bot дописывает к base_url токен, получая
# https://<worker>/bot<TOKEN>/... — именно такой путь ждёт воркер):
# TELEGRAM_API_BASE=https://your-worker.workers.dev/bot
# Оставьте пустым для прямого доступа (вне РФ).
TELEGRAM_API_BASE=

# Транспорт executor: "relay" (вторая бесплатная сессия Hy3, файл) | "deepseek" (платно)
EXECUTOR_MODE=relay

# ID opencode-сессий для 2-сессионной схемы (обе на Hy3). Поменяйте под свои.
SESSION_ARCHITECT=ses_fcd7bad25ffeBb5SMJbbmPD4bd
SESSION_EXECUTOR=ses_fc29d2d4cffeTzqf5kwP1x1DAy
SESSION_BASE=oc://renderer/server/c2lkZWNhcg/session/

STATE_PATH=orchestrator/state.json
STATUS_PATH=textdocs/STATUS.md
DECISIONS_PATH=orchestrator/decisions.json
CONTROL_PATH=orchestrator/control.json
POLL_INTERVAL_SEC=5
