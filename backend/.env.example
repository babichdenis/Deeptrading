POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deeptrading
POSTGRES_PASSWORD=deeptrading
POSTGRES_DB=deeptrading
TINKOFF_TOKEN=

# Безопасность API (опционально, пусто = auth отключена)
API_TOKEN=
# Белый список CORS-доменов через запятую (по умолчанию localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Выполнять alembic upgrade head при старте приложения (0/1, по умолчанию 0)
RUN_MIGRATIONS_ON_START=0
