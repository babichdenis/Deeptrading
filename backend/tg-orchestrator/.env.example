# ===== Telegram (обязательно) =====
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
TELEGRAM_CHAT_ID=224008722

# Cloudflare-прокси Bot API (в РФ api.telegram.org заблокирован).
# Должен ОКАНЧИВАТЬСЯ на /bot — PTB сам допишет токен.
# Это тот же воркер, что и релей (relay_worker.js).
TELEGRAM_API_BASE=https://<your-worker>.workers.dev/bot

# Режим входящих: relay (через воркер, работает в РФ) | polling | webhook
TELEGRAM_MODE=relay

# ===== Store-and-forward релей (для TELEGRAM_MODE=relay) =====
# Тот же Cloudflare-воркер, что и прокси выше. KV-binding `RELAY` обязателен.
TELEGRAM_RELAY_BASE=https://<your-worker>.workers.dev
TELEGRAM_RELAY_SECRET=замени_на_случайную_длинную_строку

# Агент по умолчанию для простых сообщений владельца в Telegram
DEFAULT_AGENT=executor

# ===== opencode Server API (драйв агентских сессий) =====
OPENCODE_SERVER_PASSWORD=пароль_из_OPENCODE_SERVER_PASSWORD_вашего_opencode
# Хост sidecar-сервера (обычно 127.0.0.1:49300)
OPENCODE_HOST=127.0.0.1:49300

# ===== Сессии агентов (ЗАМЕНИ на свои!) =====
# Возьми id сессий из opencode (например, `oc` CLI или файла состояния).
# Либо заполни orchestrator/agents_registry.json.
SESSION_ARCHITECT=ses_xxxxxxxxxxxxxxxxxxxx
SESSION_EXECUTOR=ses_yyyyyyyyyyyyyyyyyyyy
SESSION_REVIEWER=ses_zzzzzzzzzzzzzzzzzzzzz
SESSION_BASE=oc://renderer/server/c2lkZWNhcg/session/

# ===== Транспорт исполнителя =====
# relay     — пишем задачу в файл, executor забирает сам (внешняя сессия)
# deepseek  — прямой вызов DeepSeek API
# opencode  — оркестратор сам будит сессию через Server API
EXECUTOR_MODE=relay

# ===== Прочее =====
POLL_INTERVAL_SEC=5
REPORTS_DIR=orchestrator/reports
