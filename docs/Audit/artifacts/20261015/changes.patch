+    dd_reduce1_pct: float = 0.05         # просадка от пика equity → закрыть 50% позиций
+    dd_reduce2_pct: float = 0.10         # просадка от пика equity → закрыть 80% позиций
+    balance_min_positions: int = 3  # баланс L/S включается при >= N позиций
