+        `<span class="${repSignCls(r.net)}">net ${repRub(r.net)}</span>`
+      : `<span>${repTs(r.created_at)}</span><span>сделок ${repN(r.trades)}</span>` +
+        `<span>роботов ${repN(r.robots)}</span>` +
